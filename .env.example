# --- avatar-imaging service ---------------------------------------------------
# Copy to .env (or export these) before `npm start`.

# HTTP listener
AVATAR_IMAGING_HOST=0.0.0.0
AVATAR_IMAGING_PORT=8081

# --- REQUIRED: where the hotel serves gamedata + .nitro assets ----------------
# Mirror the client's renderer-config.json `gamedata.url` and `asset.url`.
#
# From these two bases the service composes, by default:
#   {GAMEDATA}/HabboAvatarActions.json   {GAMEDATA}/FigureData.json
#   {GAMEDATA}/FigureMap.json            {GAMEDATA}/EffectMap.json
#   {ASSET}/figure/%libname%.nitro       {ASSET}/effect/%libname%.nitro
#
# NITRO_GAMEDATA_URL must be the directory that DIRECTLY contains those 4 JSON
# files (e.g. if yours live in .../gamedata/config, point it at .../gamedata/config).
# NITRO_ASSET_URL is the base for the avatar FIGURE .nitro libraries (the
# "clothes"/figure bundles — NOT furniture).
NITRO_GAMEDATA_URL=https://hotel.example.com/client/gamedata
NITRO_ASSET_URL=https://hotel.example.com/client/nitro/bundled

# --- optional per-file overrides (only if your layout differs) ----------------
# Use these when the JSONs and .nitro libraries don't sit in the default spots.
# Example for a layout like  http://192.168.0.8/gamedata/{config,clothes,effect}:
#   NITRO_GAMEDATA_URL=http://192.168.0.8/gamedata/config
#   NITRO_AVATAR_ASSET_URL=http://192.168.0.8/gamedata/clothes/%libname%.nitro
#   NITRO_AVATAR_ASSET_EFFECT_URL=http://192.168.0.8/gamedata/effect/%libname%.nitro
#
# NITRO_AVATAR_ACTIONS_URL=https://hotel.example.com/client/gamedata/HabboAvatarActions.json
# NITRO_AVATAR_FIGUREDATA_URL=https://hotel.example.com/client/gamedata/FigureData.json
# NITRO_AVATAR_FIGUREMAP_URL=https://hotel.example.com/client/gamedata/FigureMap.json
# NITRO_AVATAR_EFFECTMAP_URL=https://hotel.example.com/client/gamedata/EffectMap.json
# NITRO_AVATAR_ASSET_URL=https://hotel.example.com/client/nitro/bundled/figure/%libname%.nitro
# NITRO_AVATAR_ASSET_EFFECT_URL=https://hotel.example.com/client/nitro/bundled/effect/%libname%.nitro
# NITRO_AVATAR_MANDATORY_LIBRARIES=bd:1,li:0
# NITRO_AVATAR_MANDATORY_EFFECT_LIBRARIES=dance.1,dance.2,dance.3,dance.4

# --- tuning -------------------------------------------------------------------
# Warm renderer pages (also the max concurrent renders). More = more RAM.
AVATAR_IMAGING_POOL=2
# Animation playback rate for APNG output (frame delay = 1000/fps; lower =
# slower). Habbo avatars animate around 12fps. Plus a hard cap on frames/image.
AVATAR_IMAGING_FPS=12
AVATAR_IMAGING_MAX_FRAMES=60
# Response cache
AVATAR_IMAGING_CACHE_ENTRIES=512
AVATAR_IMAGING_CACHE_TTL_MS=300000
# Timeouts
AVATAR_IMAGING_RENDER_TIMEOUT_MS=30000
AVATAR_IMAGING_BOOT_TIMEOUT_MS=60000

# Verbose per-render diagnostics (effect sprite/asset resolution, frame counts).
# Off by default; set to 1 to troubleshoot effects/assets.
# AVATAR_IMAGING_DEBUG=1

# --- hardening ----------------------------------------------------------------
# Behind a reverse proxy (nginx/Cloudflare), set this so the real client IP is
# used for rate limiting. "true", a hop count (e.g. 1), or a subnet.
# AVATAR_IMAGING_TRUST_PROXY=true
# Per-IP rate limit (fixed window). Set MAX to 0 to disable.
AVATAR_IMAGING_RATELIMIT_WINDOW_MS=60000
AVATAR_IMAGING_RATELIMIT_MAX=120
# Reject with 503 once this many requests are queued for the render pool.
# AVATAR_IMAGING_MAX_QUEUE=16
# Require an API key (?key= or X-API-Key header). Comma-separated; empty = public.
# AVATAR_IMAGING_API_KEYS=key1,key2
# CORS allow-origin for the image endpoint (e.g. https://cms.example or *).
# Not needed for plain <img> embedding.
# AVATAR_IMAGING_CORS_ORIGIN=
# Input caps (defaults are generous).
# AVATAR_IMAGING_MAX_FIGURE_LEN=512
# AVATAR_IMAGING_MAX_ACTION_LEN=256

# Optional fixed output canvas (in size=n pixels), e.g. "64,110" for full body
# and "40,42" for headonly. Leave unset for content-tight output.
# AVATAR_IMAGING_CANVAS_FULL=64,110
# AVATAR_IMAGING_CANVAS_HEAD=40,42

# Chromium binary. Defaults to the Playwright-managed browser. In the Claude
# web/remote environment set it to the pre-installed build:
# CHROMIUM_PATH=/opt/pw-browsers/chromium-1194/chrome-linux/chrome
