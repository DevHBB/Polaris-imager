# systemd unit for the Nitro avatar-imaging service.
# Install as /etc/systemd/system/avatar-imaging.service and adjust the paths /
# User to match your setup. See the README "Deploying on Ubuntu (systemd)".

[Unit]
Description=Nitro avatar-imaging service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=avatar
Group=avatar

# Where the service lives (contains src/, dist-harness/, .env, the renderer link).
WorkingDirectory=/opt/avatar-imaging
EnvironmentFile=/opt/avatar-imaging/.env
Environment=NODE_ENV=production
# Pin the Playwright browser location so it works under ProtectHome=true.
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/avatar-imaging/pw-browsers

# Fail fast with a clear message if the harness bundle isn't built yet.
ExecStartPre=/usr/bin/node scripts/ensure-harness.mjs
ExecStart=/usr/bin/node src/server.mjs

Restart=on-failure
RestartSec=5

# --- hardening ---------------------------------------------------------------
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
RestrictRealtime=true
# Everything is read-only except the access-log directory (in-memory cache aside).
ReadWritePaths=/var/log/avatar-imaging

# --- resource limits (see the README "Memory & sizing") ----------------------
LimitNOFILE=65535
# Hard memory ceiling — with page recycling + the byte-capped cache, a pool of 2
# stays well under this. Raise if you increase AVATAR_IMAGING_POOL.
MemoryMax=2G

[Install]
WantedBy=multi-user.target
