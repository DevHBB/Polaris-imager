# Example nginx reverse proxy + cache for the avatar-imaging service.
#
# This is where the real CPU offload happens: nginx caches rendered images and
# serves repeat requests itself, so most traffic never reaches Node or the
# renderer. Copy the relevant bits into your nginx config and adjust the
# server_name / TLS paths / upstream address.
#
# The imaging service should listen on loopback only in this setup — bind it to
# 127.0.0.1 (AVATAR_IMAGING_HOST=127.0.0.1) so it is reachable only via nginx.

# --- shared (http {} context) -------------------------------------------------

# On-disk cache. 10m of keys ~= 80k entries; 2g is the max body cache size.
proxy_cache_path /var/cache/nginx/avatar-imaging
                 levels=1:2
                 keys_zone=avatar_cache:10m
                 max_size=2g
                 inactive=7d
                 use_temp_path=off;

# Per-IP rate limit at the edge (the service also rate-limits itself).
limit_req_zone $binary_remote_addr zone=avatar_rl:10m rate=20r/s;

upstream avatar_imaging {
    server 127.0.0.1:8081;
    keepalive 16;
}

# --- server (server {} context) -----------------------------------------------
server {
    listen 443 ssl http2;
    server_name imaging.yourhotel.com;

    # ssl_certificate     /etc/letsencrypt/live/imaging.yourhotel.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/imaging.yourhotel.com/privkey.pem;

    # Never expose the internal-only routes, even though the service already
    # restricts them to loopback (defense in depth).
    location = /renderer-config.json { return 404; }
    location /harness/              { return 404; }

    location /avatarimage {
        limit_req zone=avatar_rl burst=40 nodelay;

        proxy_cache            avatar_cache;
        # Cache key = the normalized query (the image is a pure function of it).
        proxy_cache_key        "$scheme$request_method$host$uri$is_args$args";
        proxy_cache_valid      200 7d;   # honour upstream Cache-Control if present
        proxy_cache_valid      404 1m;
        proxy_cache_lock       on;       # collapse concurrent misses into one render
        proxy_cache_use_stale  updating error timeout;
        add_header             X-Cache-Status $upstream_cache_status;

        # Pass the real client IP so the service's own rate limiter + access log
        # see it (set AVATAR_IMAGING_TRUST_PROXY=true, and
        # AVATAR_IMAGING_CLIENT_IP_HEADER=x-forwarded-for in the service).
        proxy_set_header       Host $host;
        proxy_set_header       X-Real-IP $remote_addr;
        proxy_set_header       X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header       X-Forwarded-Proto $scheme;
        # Behind Cloudflare, forward its real-visitor header and set
        # AVATAR_IMAGING_CLIENT_IP_HEADER=cf-connecting-ip instead.
        proxy_set_header       CF-Connecting-IP $http_cf_connecting_ip;

        proxy_http_version     1.1;
        proxy_set_header       Connection "";
        proxy_pass             http://avatar_imaging;
    }

    # Optional: health check (not cached).
    location = /health {
        proxy_pass http://avatar_imaging;
    }
}

# Notes
# - Run the service as a non-root user (e.g. via systemd `User=`).
# - `proxy_cache_lock on` means a burst of identical first-time requests triggers
#   a single render, not one per request — important protection.
# - Because a figure+params URL always renders the same image, cache lifetimes
#   can be long; a changed look is simply a different URL.
# - For a public/global audience, put a CDN (Cloudflare, etc.) in front of nginx
#   and it will absorb the bulk of traffic before it even reaches this box.
